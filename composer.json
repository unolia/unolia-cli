{
    "name": "unolia/unolia-cli",
    "description": "Command line interface for Unolia, for humans and agents",
    "type": "project",
    "keywords": ["unolia", "dns", "console", "cli"],
    "homepage": "https://unolia.com",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/unolia/unolia-cli/issues",
        "source": "https://github.com/unolia/unolia-cli"
    },
    "authors": [
        {
            "name": "Eser DENIZ",
            "email": "srwiez@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel-zero/phar-updater": "^1.4",
        "laravel/prompts": "^0.3.21",
        "lorisleiva/cron-translator": "^0.5.2",
        "react/dns": "^1.12",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/saloon": "^4.0",
        "symfony/console": "^7.4",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Unolia\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": ["bin/unolia"],
    "scripts": {
        "test": "vendor/bin/pest -p",
        "pint": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse",
        "build": "box compile",
        "qa": [
            "@pint",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
